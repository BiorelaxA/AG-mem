# Python and build outputs
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/
*.egg-info/
build/
dist/

# Local environments, caches and credentials
/.venv/
/venv/
/.conda/
.cache/
/.aws/
/.codex/
.env
.env.*
!.env.example
