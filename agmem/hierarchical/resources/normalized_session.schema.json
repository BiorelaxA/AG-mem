{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "NormalizedSessionV1",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "session.v1"
    },
    "bank_id": {
      "type": "string",
      "minLength": 1
    },
    "parent_id": {
      "type": "string",
      "minLength": 1
    },
    "source_kind": {
      "enum": [
        "dialogue",
        "agent"
      ]
    },
    "order": {
      "type": "integer",
      "minimum": 1
    },
    "time": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "raw": {
          "type": [
            "string",
            "null"
          ]
        },
        "iso": {
          "type": [
            "string",
            "null"
          ]
        },
        "timezone": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "required": [
        "raw",
        "iso",
        "timezone"
      ]
    },
    "participants": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 1
      }
    },
    "header_records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "message",
              "action",
              "observation",
              "note",
              "final",
              "task_instruction",
              "initial_observation"
            ]
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "image",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "ref",
                "caption"
              ]
            }
          }
        },
        "required": [
          "record_id",
          "seq",
          "kind",
          "speaker",
          "call_id",
          "text",
          "attachments"
        ]
      }
    },
    "records": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "record_id": {
            "type": "string",
            "minLength": 1
          },
          "seq": {
            "type": "integer",
            "minimum": 1
          },
          "kind": {
            "enum": [
              "message",
              "action",
              "observation",
              "note",
              "final",
              "task_instruction",
              "initial_observation"
            ]
          },
          "speaker": {
            "type": [
              "string",
              "null"
            ]
          },
          "call_id": {
            "type": [
              "string",
              "null"
            ]
          },
          "text": {
            "type": "string"
          },
          "attachments": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "kind": {
                  "enum": [
                    "image",
                    "other"
                  ]
                },
                "ref": {
                  "type": "string",
                  "minLength": 1
                },
                "caption": {
                  "type": [
                    "string",
                    "null"
                  ]
                }
              },
              "required": [
                "kind",
                "ref",
                "caption"
              ]
            }
          }
        },
        "required": [
          "record_id",
          "seq",
          "kind",
          "speaker",
          "call_id",
          "text",
          "attachments"
        ]
      }
    },
    "blocks": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "index": {
            "type": "integer",
            "minimum": 1
          },
          "record_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "minLength": 1
            }
          },
          "token_count": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "index",
          "record_ids",
          "token_count"
        ]
      }
    },
    "source_hash": {
      "type": "string",
      "minLength": 1
    }
  },
  "required": [
    "schema_version",
    "bank_id",
    "parent_id",
    "source_kind",
    "order",
    "time",
    "participants",
    "header_records",
    "records",
    "blocks",
    "source_hash"
  ]
}
